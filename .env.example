# Токен бота от @BotFather
BOT_TOKEN=

# Юзернейм бота без @ (для реферальных ссылок)
BOT_USERNAME=

# Ваш Telegram ID — только этот пользователь может добавлять промокоды (/addpromo)
ADMIN_ID=

# Публичный URL, где размещён мини-апп (https обязателен для Telegram)
WEBAPP_URL=https://example.com

# 1 = разрешить вход без Telegram (для локальной разработки в браузере)
DEV_MODE=0
